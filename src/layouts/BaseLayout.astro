---
interface Props {
  titulo: string;
  descricao: string;
  canonical?: string;
}
const { titulo, descricao, canonical } = Astro.props;
const siteName = 'Caderno do Autônomo';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2838794127917125" crossorigin="anonymous"></script>
  <meta name="google-site-verification" content="xphJb-6ddldWgjzdGDfzjxOto_vBycfTN72W" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo} · {siteName}</title>
  <meta name="description" content={descricao} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="article" />
</head>
<body>
  <div class="ledger-strip" aria-hidden="true">
    <span>MEI · CARTÃO · EMPRÉSTIMO · INVESTIMENTO INICIANTE</span>
  </div>

  <header class="site-header">
    <a href="/" class="wordmark">Caderno do Autônomo</a>
    <nav class="site-nav">
      <a href="/categoria/mei-autonomo">MEI</a>
      <a href="/categoria/cartao-de-credito">Cartão</a>
      <a href="/categoria/emprestimo-financiamento">Empréstimo</a>
      <a href="/categoria/investimentos-iniciantes">Investimentos</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>
        <p class="footer-wordmark">Caderno do Autônomo</p>
        <p class="footer-note">Educação financeira prática para quem trabalha por conta própria no Brasil.</p>
      </div>
      <div>
        <a href="/sobre">Sobre</a>
        <a href="/contato">Contato</a>
        <a href="/politica-de-privacidade">Política de Privacidade</a>
        <a href="/disclaimer">Aviso Legal</a>
      </div>
    </div>
    <p class="footer-legal">Conteúdo educativo, não é recomendação de investimento ou consultoria financeira individual.</p>
  </footer>

  <style is:global>
    :root {
      --paper: #EDEAE2;
      --paper-raised: #F5F3ED;
      --ink: #1C2333;
      --ink-soft: #4A5266;
      --gold: #B8912F;
      --teal: #2B6E64;
      --line: #D8D3C6;
      --serif: 'Fraunces', Georgia, serif;
      --sans: 'IBM Plex Sans', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.55;
    }
    h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.15; color: var(--ink); }
    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

    .ledger-strip {
      background: var(--ink);
      color: var(--paper);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      padding: 0.4rem 1.5rem;
      overflow: hidden;
      white-space: nowrap;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
      max-width: 1080px;
      margin: 0 auto;
      border-bottom: 1px solid var(--line);
    }
    .wordmark {
      font-family: var(--serif);
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--ink);
    }
    .wordmark:hover { text-decoration: none; }
    .site-nav { display: flex; gap: 1.5rem; font-size: 0.95rem; }
    .site-nav a { color: var(--ink-soft); }

    main { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }

    .site-footer {
      margin-top: 4rem;
      border-top: 1px solid var(--line);
      padding: 2.5rem 1.5rem 2rem;
    }
    .footer-grid {
      max-width: 1080px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .footer-wordmark { font-family: var(--serif); font-size: 1.1rem; margin: 0 0 0.4rem; }
    .footer-note { color: var(--ink-soft); max-width: 32ch; margin: 0; font-size: 0.9rem; }
    .footer-grid nav a, .footer-grid > div a { display: block; margin-bottom: 0.5rem; color: var(--ink-soft); font-size: 0.9rem; }
    .footer-legal {
      max-width: 1080px;
      margin: 1.5rem auto 0;
      font-size: 0.78rem;
      color: var(--ink-soft);
      border-top: 1px dashed var(--line);
      padding-top: 1rem;
    }

    @media (max-width: 640px) {
      .site-header { flex-direction: column; gap: 1rem; align-items: flex-start; }
      .site-nav { flex-wrap: wrap; gap: 1rem; }
    }
  </style>
</body>
</html>
