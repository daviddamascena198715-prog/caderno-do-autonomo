---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos');
  return artigos.map((artigo) => ({
    params: { slug: artigo.slug },
    props: { artigo },
  }));
}

const { artigo } = Astro.props;
const { Content } = await artigo.render();
const url = new URL(`/artigo/${artigo.slug}`, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: artigo.data.titulo,
  description: artigo.data.resumo,
  datePublished: artigo.data.dataPublicacao.toISOString(),
  dateModified: (artigo.data.dataAtualizacao ?? artigo.data.dataPublicacao).toISOString(),
  author: { '@type': 'Organization', name: artigo.data.autor },
};
---
<BaseLayout titulo={artigo.data.titulo} descricao={artigo.data.resumo} canonical={url}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="artigo">
    <p class="artigo-categoria">
      <a href={`/categoria/${artigo.data.categoria}`}>{artigo.data.categoria.replace(/-/g, ' ')}</a>
    </p>
    <h1>{artigo.data.titulo}</h1>
    <p class="artigo-meta">
      Publicado em {artigo.data.dataPublicacao.toLocaleDateString('pt-BR')}
      {artigo.data.dataAtualizacao && ` · Atualizado em ${artigo.data.dataAtualizacao.toLocaleDateString('pt-BR')}`}
      {' · '}{artigo.data.autor}
    </p>

    <div class="artigo-corpo">
      <Content />
    </div>

    {artigo.data.fontes.length > 0 && (
      <aside class="fontes">
        <h2>Fontes</h2>
        <ul>
          {artigo.data.fontes.map((f) => (
            <li>
              {typeof f === 'string' ? (
                f
              ) : (
                <a href={f.url} target="_blank" rel="noopener noreferrer">{f.nome}</a>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  <style>
    .artigo { max-width: 68ch; margin: 2.5rem auto 4rem; }
    .artigo-categoria { font-size: 0.85rem; margin: 0 0 0.5rem; }
    .artigo-categoria a { text-transform: capitalize; }
    .artigo h1 { font-size: 2rem; margin: 0 0 0.6rem; }
    .artigo-meta { color: var(--ink-soft); font-size: 0.88rem; border-bottom: 1px solid var(--line); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
    .artigo-corpo :global(h2) { font-size: 1.4rem; margin-top: 2rem; }
    .artigo-corpo :global(p) { margin: 1rem 0; }
    .artigo-corpo :global(a) { color: var(--teal); }
    .fontes { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px dashed var(--line); font-size: 0.88rem; color: var(--ink-soft); }
    .fontes h2 { font-size: 1rem; margin-bottom: 0.5rem; }
    .fontes a { color: var(--teal); text-decoration: underline; }
  </style>
</BaseLayout>
