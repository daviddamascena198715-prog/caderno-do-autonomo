---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout titulo="Contato" descricao="Entre em contato com o Caderno do Autônomo.">
  <article class="pagina">
    <h1>Contato</h1>
    <p>
      [EDITAR] Coloque um e-mail de contato real e monitorado (ex: contato@seudominio.com.br).
      Uma via de contato funcional é um dos requisitos que o Google verifica na aprovação do AdSense.
    </p>
  </article>
  <style>
    .pagina { max-width: 60ch; margin: 2.5rem auto 4rem; }
    .pagina p { margin: 1rem 0; color: var(--ink-soft); }
  </style>
</BaseLayout>
