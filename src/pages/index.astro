---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const artigos = (await getCollection('artigos')).sort(
  (a, b) => b.data.dataPublicacao.valueOf() - a.data.dataPublicacao.valueOf()
);
const destaque = artigos.find((a) => a.data.destaque) ?? artigos[0];
const restantes = artigos.filter((a) => a.slug !== destaque?.slug);

const categorias = [
  { slug: 'mei-autonomo', nome: 'MEI e Autônomo' },
  { slug: 'cartao-de-credito', nome: 'Cartão de Crédito' },
  { slug: 'emprestimo-financiamento', nome: 'Empréstimo e Financiamento' },
  { slug: 'investimentos-iniciantes', nome: 'Investimentos para Iniciantes' },
];
---
<BaseLayout
  titulo="Finanças práticas para quem trabalha por conta própria"
  descricao="Cartão de crédito, MEI, empréstimo e primeiros investimentos explicados sem enrolação para autônomos e freelancers no Brasil."
>
  <section class="hero">
    <h1>Finanças para quem não tem carteira assinada.</h1>
    <p class="hero-sub">
      MEI, cartão, empréstimo e primeiros investimentos — explicado do jeito que autônomo e freelancer
      realmente precisa entender, sem jargão de banco.
    </p>
  </section>

  {destaque && (
    <a class="destaque-card" href={`/artigo/${destaque.slug}`}>
      <span class="destaque-tag">Destaque</span>
      <h2>{destaque.data.titulo}</h2>
      <p>{destaque.data.resumo}</p>
    </a>
  )}

  <section class="categorias-grid">
    {categorias.map((c) => (
      <a href={`/categoria/${c.slug}`} class="categoria-card">
        {c.nome}
      </a>
    ))}
  </section>

  <section class="lista-artigos">
    <h2 class="section-title">Últimos artigos</h2>
    <ul>
      {restantes.map((a) => (
        <li>
          <a href={`/artigo/${a.slug}`}>{a.data.titulo}</a>
          <p>{a.data.resumo}</p>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .hero { padding: 3rem 0 2rem; max-width: 62ch; }
    .hero h1 { font-size: 2.4rem; margin: 0 0 0.75rem; }
    .hero-sub { color: var(--ink-soft); font-size: 1.1rem; }

    .destaque-card {
      display: block;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-left: 4px solid var(--gold);
      padding: 1.75rem;
      margin-bottom: 2.5rem;
      color: var(--ink);
    }
    .destaque-card:hover { text-decoration: none; border-left-color: var(--teal); }
    .destaque-tag { font-size: 0.78rem; color: var(--gold); font-weight: 600; }
    .destaque-card h2 { margin: 0.4rem 0 0.5rem; font-size: 1.5rem; }
    .destaque-card p { margin: 0; color: var(--ink-soft); }

    .categorias-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      margin-bottom: 3rem;
    }
    .categoria-card {
      background: var(--paper);
      padding: 1.25rem 1rem;
      text-align: center;
      font-weight: 500;
      color: var(--ink);
    }
    .categoria-card:hover { background: var(--paper-raised); text-decoration: none; color: var(--teal); }

    .section-title { font-size: 1.3rem; border-bottom: 1px solid var(--line); padding-bottom: 0.6rem; margin-bottom: 1.5rem; }
    .lista-artigos ul { list-style: none; padding: 0; margin: 0; }
    .lista-artigos li { padding: 1.2rem 0; border-bottom: 1px dashed var(--line); }
    .lista-artigos li a { font-size: 1.15rem; font-weight: 500; color: var(--ink); }
    .lista-artigos li p { margin: 0.3rem 0 0; color: var(--ink-soft); }

    @media (max-width: 720px) {
      .categorias-grid { grid-template-columns: repeat(2, 1fr); }
      .hero h1 { font-size: 1.9rem; }
    }
  </style>
</BaseLayout>
